# Secrets / local config - never commit the real values
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Airflow runtime artifacts
logs/
airflow.db
airflow-webserver.pid

# Generated pipeline data - large, regenerable from source, not source-of-truth.
# Keep the directories themselves tracked (see data/*/.gitkeep) but not
# their contents.
data/raw/*
data/staging/*
data/curated/*
data/quality_reports/*
!data/raw/.gitkeep
!data/staging/.gitkeep
!data/curated/.gitkeep

# data/incoming/ is a LOCAL drop zone for downloaded source files before
# ingestion (e.g. the Chicago bulk CSV, UK annual files) - never commit
# the actual multi-hundred-MB datasets, and never point an extractor's
# --input/--input-dir at data/raw/ directly (see README "Data Layers").
data/incoming/*
!data/incoming/.gitkeep

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Jupyter notebook checkpoints (auto-generated)
.ipynb_checkpoints/
*.ipynb_checkpoints/

# Python caches (already covered but worth confirming)
**/__pycache__/
**/*.pyc
