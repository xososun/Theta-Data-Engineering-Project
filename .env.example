# .env.example
#
# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored (see .gitignore) - never commit
# the real file.

# --- PostgreSQL (curated crash-data database) ---
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=changeme_use_a_real_password
POSTGRES_DB=crash_pipeline
POSTGRES_PORT=5432

# --- Airflow ---
# Airflow needs its OWN database name, separate from the app's
# POSTGRES_DB above, even though both live in the same postgres
# container/instance (see docker-compose.yml comments).
AIRFLOW_DB=airflow_metadata

# Generate a real Fernet key before first run - do NOT leave this blank or
# reuse the placeholder below in any real deployment:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=changeme_generate_a_real_fernet_key

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme_use_a_real_password
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_WEBSERVER_PORT=8080

# --- Source-specific settings (API endpoints are already in
#     config/adapters/*.yaml since they're not secret; this is only for
#     anything that genuinely must not be committed, e.g. if a source
#     later requires an API key/token) ---
# NYC_SOCRATA_APP_TOKEN=            # optional: raises the NYC API's unauthenticated rate limit if set
